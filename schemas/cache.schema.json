{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://msoltanov.github.io/profile/schemas/v1/cache.schema.json",
  "title": "Decoded activity cache",
  "description": "Deduplicated authored commit data.",
  "$comment": "Version-one field names, lower-case enum values and nullable snapshot fields remain compatible with the existing persisted formats.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "authorId", "commits", "heads"],
  "properties": {
    "version": {
      "type": "integer",
      "description": "Decoded payload format version.",
      "const": 1
    },
    "authorId": {
      "type": "string",
      "description": "GitHub author node identifier.",
      "minLength": 1,
      "maxLength": 1024,
      "examples": ["FIXTURE_AUTHOR"]
    },
    "commits": {
      "type": "array",
      "description": "Deduplicated commit records.",
      "items": {
        "type": "array",
        "description": "Object identifier, additions, deletions and parent count.",
        "prefixItems": [
          {
            "$ref": "#/$defs/oid",
            "description": "Commit object identifier."
          },
          {
            "$ref": "#/$defs/count",
            "description": "Added lines."
          },
          {
            "$ref": "#/$defs/count",
            "description": "Deleted lines."
          },
          {
            "$ref": "#/$defs/count",
            "description": "Parent count."
          }
        ],
        "items": false,
        "minItems": 4,
        "maxItems": 4
      },
      "maxItems": 1000000,
      "examples": [[["bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", 5, 1, 0]]]
    },
    "heads": {
      "type": "object",
      "description": "Branch-head object identifiers mapped to commit indexes.",
      "additionalProperties": false,
      "patternProperties": {
        "^(?:[a-f0-9]{40}|[a-f0-9]{64})$": {
          "type": "array",
          "description": "Indexes into commits for one complete branch history.",
          "items": {
            "type": "integer",
            "description": "Zero-based commit index.",
            "minimum": 0,
            "maximum": 999999
          },
          "maxItems": 1000000
        }
      },
      "maxProperties": 100000,
      "required": [],
      "examples": [
        {
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": [0]
        }
      ]
    }
  },
  "$defs": {
    "oid": {
      "type": "string",
      "description": "SHA-1 or SHA-256 Git object identifier.",
      "minLength": 40,
      "maxLength": 64,
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "count": {
      "type": "integer",
      "description": "Nonnegative safe aggregate count.",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
