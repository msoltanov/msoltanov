{
  "name": "alabay-code-profile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "node scripts/generate-profile.mjs",
    "test": "node --test",
    "check": "npm run lint && npm run format:check && npm run validate:data && npm run check:assets",
    "check:assets": "node scripts/check.mjs",
    "check:preview": "node scripts/check-preview.mjs",
    "lint": "npm run lint:js && npm run lint:yaml && npm run lint:markdown && npm run lint:css",
    "lint:js": "eslint . --max-warnings=0",
    "lint:yaml": "python -B -m yamllint --strict -c .yamllint.yml .github .yamllint.yml",
    "lint:markdown": "node scripts/check-markdown.mjs",
    "lint:css": "stylelint \".preview/*.css\" --allow-empty-input --max-warnings 0",
    "format": "prettier --ignore-path .prettierignore --write .",
    "format:check": "prettier --ignore-path .prettierignore --check .",
    "validate:data": "node scripts/validate-data.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@resvg/resvg-js": "2.6.2",
    "@xmldom/xmldom": "0.9.12",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "gifenc": "1.0.3",
    "globals": "17.14.0",
    "html-validate": "11.21.0",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-order": "8.1.3"
  },
  "overrides": {
    "eslint": {
      "minimatch": "11.0.1"
    }
  }
}
